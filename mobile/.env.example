# URL base de la API. En desarrollo, el backend de LUMA corre en localhost:8080
# (ver backend/src/main/resources/application.yml). Un dispositivo fisico o un
# emulador no siempre ven "localhost" como la maquina donde corre el backend:
# usa la IP de tu red local, o el tunel que da `expo start --tunnel`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
