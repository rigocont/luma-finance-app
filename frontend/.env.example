# En desarrollo se usa el proxy de Vite, asi que basta una ruta relativa.
VITE_API_BASE_URL=/api/v1

# Al construir la imagen de Docker se pasa la URL absoluta del backend:
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cuenta y espacio de Google AdSense. Vacias en desarrollo: sin ellas,
# el espacio de anuncio se reserva con un marcador y no llama a nada externo.
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_ID=
