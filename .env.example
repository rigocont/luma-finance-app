# Copia este archivo como .env antes de levantar Docker Compose.
# .env esta en .gitignore: los secretos reales nunca se versionan.

# ---- Base de datos ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=luma
MYSQL_USER=luma
MYSQL_PASSWORD=luma
MYSQL_PORT=3306

# ---- Backend ----
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
LUMA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Minimo 32 caracteres. En cualquier ambiente real, un valor generado y secreto.
LUMA_JWT_SECRET=desarrollo-local-luma-clave-de-al-menos-32-caracteres
# En cualquier ambiente con HTTPS debe ser true.
LUMA_COOKIE_SECURE=false
# Cuanto se espera antes de invalidar lo capturado en un alta que nadie termino.
# Se cuenta desde la ultima captura. En 0 se apaga la limpieza.
LUMA_ONBOARDING_ABANDON_AFTER=7d

# ---- Correo (Mailpit en local) ----
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Base de los enlaces que se envian por correo. Debe ser la URL de la aplicacion.
LUMA_APP_BASE_URL=http://localhost:8081

# ---- Frontend ----
FRONTEND_PORT=8081
VITE_API_BASE_URL=http://localhost:8080/api/v1
